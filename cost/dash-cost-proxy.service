[Unit]
Description=Bastion cost add-on: Ollama logging proxy (:11435)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/dashboard/addons/cost/agent
ExecStart=/usr/bin/python3 -I /root/dashboard/addons/cost/agent/cost_proxy.py
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
